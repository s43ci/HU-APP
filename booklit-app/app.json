{
  "expo": {
    "name": "Booklit",
    "slug": "booklit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "booklit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.booklit.app"
    },
    "android": {
      "package": "com.booklit.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBFDFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://booklit.expo.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFDFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Booklit uses your photos so you can add images to your booklets.",
          "cameraPermission": "Booklit uses the camera so you can photograph figures for your booklets."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "21780752-ca27-448a-bc5e-c10eaa1da81e"
      }
    },
    "owner": "sigha2026s-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/21780752-ca27-448a-bc5e-c10eaa1da81e"
    }
  }
}